    <jobString>Weaving Gargantua Cores in bulk.</jobString>
    <effectWorking>Milira_SunBlastFurnaceBurning</effectWorking>
    <soundWorking>MiliraRecipe_SunBlastFurnace</soundWorking>
    <workAmount>22500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Milira_PsionicCore</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Milira_Neutronium</li>
          </thingDefs>
        </filter>
        <count>60</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Milira_DarkMatter</li>
          </thingDefs>
        </filter>
        <count>9</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Milira_SunPlateSteel</li>
          </thingDefs>
        </filter>
        <count>45</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>45</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Jade</li>
          </thingDefs>
        </filter>
        <count>30</count>
      </li>
    </ingredients>
    <products>
      <Milira_GargantuaCore>3</Milira_GargantuaCore>
    </products>
    <recipeUsers>
      <li>Milira_GravityLoom</li>
    </recipeUsers>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>Milira_Imperium_DarkMatterConstraint</researchPrerequisite>
  </RecipeDef>

  <!-- 金色米莉拉之羽 x5：单件 6000 → 批量 25000 -->
  <RecipeDef>
    <defName>GNH_Recipe_GoldenMiliraFeather_Bulk</defName>
    <label>Weave Golden Milira Feather x5</label>
    <description>Weave five Golden Milira Feathers in the gravity loom in one batch.</description>
    <jobString>Weaving Golden Milira Feathers in bulk.</jobString>
    <effectWorking>Milira_SunBlastFurnaceBurning</effectWorking>
    <soundWorking>MiliraRecipe_SunBlastFurnace</soundWorking>
    <workAmount>25000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Milira_Feather</li>
          </thingDefs>
        </filter>
        <count>100</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>MI_Thing_ShroudAsh</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>150</count>
      </li>
    </ingredients>
    <products>
      <Milira_Feather_gold>5</Milira_Feather_gold>
    </products>
    <recipeUsers>
      <li>Milira_GravityLoom</li>
    </recipeUsers>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>Milira_ImperiumPsyBlade</researchPrerequisite>
  </RecipeDef>

</Defs>
