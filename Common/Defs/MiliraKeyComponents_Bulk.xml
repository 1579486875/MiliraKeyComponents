  <!-- ═══════════ 太阳熔炉（x3 批量）═══════════ -->

  <!-- 职阶许可：国王 x3：单件 7000 → 批量 17500 -->
  <RecipeDef MayRequire="Ludeon.RimWorld.Biotech,Ancot.MiliraRace">
    <defName>GNH_Recipe_NamePlate_King_Bulk</defName>
    <label>Etch Class Permit: King x3</label>
    <description>Etch three King-class identity chips in the solar furnace in one batch.</description>
    <jobString>Etching King-class permits in bulk.</jobString>
    <effectWorking>Milira_SunBlastFurnaceBurning</effectWorking>
    <soundWorking>MiliraRecipe_SunBlastFurnace</soundWorking>
    <workAmount>17500</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Milira_SunPlateSteel</li>
          </thingDefs>
        </filter>
        <count>60</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Milira_SolarCrystal</li>
          </thingDefs>
        </filter>
        <count>45</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>6</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <!-- Gold 在原版带着 smallVolume=true，所以这类配方的 count 单位是「10 个」：
                     count 2 就是实际 20 个金。这行原先是 60，等于要 60 个金，
                     已于 2026-10-04 按「期望个数 ÷ 10」修正为 6。改这里之前请先读本文件顶部的说明。 -->
        <count>6</count>
      </li>
    </ingredients>
    <products>
      <Milian_NamePlate_King>3</Milian_NamePlate_King>
    </products>
    <recipeUsers>
      <li>Milira_SunBlastFurnace</li>
    </recipeUsers>
    <workSkill>Crafting</workSkill>
    <researchPrerequisite>Milira_SunBlastFurnace_Build</researchPrerequisite>
  </RecipeDef>

